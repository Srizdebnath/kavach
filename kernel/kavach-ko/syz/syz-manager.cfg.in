{
	"target": "linux/amd64",
	"http": "127.0.0.1:56741",
	"workdir": "@WORKDIR@",
	"kernel_obj": "@KSRC@",
	"kernel_src": "@KSRC@",
	"image": "@IMAGE@",
	"sshkey": "@SSHKEY@",
	"syzkaller": "@SYZKALLER@",
	"procs": 2,
	"sandbox": "none",
	"cover": true,
	"reproduce": true,
	"type": "qemu",
	"enable_syscalls": [
		"syz_btf_id_by_name$kavach_evaluate",
		"syz_btf_id_by_name$bpf_lsm",
		"bpf$MAP_CREATE_kavach_policy",
		"bpf$MAP_UPDATE_ELEM_kavach_policy",
		"bpf$PROG_LOAD_kavach_tc",
		"bpf$PROG_LOAD_kavach_lsm",
		"bpf$BPF_PROG_TEST_RUN_kavach",
		"bpf$BPF_RAW_TRACEPOINT_OPEN_kavach",
		"bpf$MAP_CREATE",
		"bpf$MAP_UPDATE_ELEM",
		"bpf$MAP_DELETE_ELEM",
		"bpf$BPF_PROG_TEST_RUN",
		"bpf$PROG_LOAD",
		"bpf$BPF_PROG_WITH_BTFID_LOAD",
		"close",
		"socket$inet_tcp",
		"socket$inet6_tcp",
		"socket$inet_udp",
		"connect$inet",
		"connect$inet6",
		"sendto$inet",
		"sendmsg$inet"
	],
	"vm": {
		"count": @VMS@,
		"cpu": 2,
		"mem": 2048,
		"kernel": "@KSRC@/arch/x86/boot/bzImage",
		"cmdline": "lsm=landlock,lockdown,yama,bpf net.ifnames=0"
	}
}
